#!/usr/bin/env bash
#
# Ops Room launcher.
#
# Runs the sidecar from the PROMOTED RELEASE (var/current/opsroom) while the
# agent edits the WORKING TREE (opsroom/). Those must be different directories,
# or a self-edit modifies the code that is currently executing, which is how a
# broken edit killed the agent mid-task on 2026-08-22, before verify could
# refuse it. Separating them means an in-progress edit cannot touch the running
# process; the new code only takes effect once a release is built, verified and
# promoted.
#
#   ./ops "which repos have uncommitted changes?"
#   ./ops --dev "..."     run the working tree instead (for iterating on the
#                         sidecar itself; no release needed)
#
# Secrets stay in <repo>/.env and are never copied into a release; the path is
# passed through so a release can read the canonical file.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RELEASE_DIR="$REPO/var/current/opsroom"
WORKTREE_DIR="$REPO/opsroom"

DEV=0
if [ "${1:-}" = "--dev" ]; then
  DEV=1
  shift
fi

if [ "$DEV" -eq 1 ]; then
  RUN_DIR="$WORKTREE_DIR"
  echo "ops: --dev, running the WORKING TREE (edits take effect immediately)" >&2
elif [ -f "$RELEASE_DIR/src/ask.ts" ]; then
  RUN_DIR="$RELEASE_DIR"
else
  RUN_DIR="$WORKTREE_DIR"
  echo "ops: no promoted release at var/current/opsroom, falling back to the" >&2
  echo "     working tree. Run: python -m supervisor release create && ... promote" >&2
fi

if [ ! -d "$RUN_DIR/node_modules" ]; then
  echo "ops: $RUN_DIR/node_modules is missing." >&2
  echo "     Releases symlink it from the repo; run 'npm install' in opsroom/ first." >&2
  exit 1
fi

# Resolve node explicitly. When GSO-1 spawns this, PATH is the bare launchd
# default (/usr/bin:/bin:/usr/sbin:/sbin), no Homebrew, no nvm, so relying on
# `exec node` gives "node: not found". Same applies under the Electron app and
# any launchd/cron context.
find_node() {
  if [ -n "${OPSROOM_NODE:-}" ] && [ -x "$OPSROOM_NODE" ]; then echo "$OPSROOM_NODE"; return; fi
  if command -v node >/dev/null 2>&1; then command -v node; return; fi
  for c in \
    /opt/homebrew/bin/node \
    /opt/homebrew/opt/node@24/bin/node \
    /usr/local/bin/node \
    "$HOME"/.nvm/versions/node/*/bin/node
  do
    [ -x "$c" ] && { echo "$c"; return; }
  done
}

NODE="$(find_node)"
if [ -z "$NODE" ]; then
  echo "ops: could not find node." >&2
  echo "     Set OPSROOM_NODE=/path/to/node, or install node >= 22.19." >&2
  exit 1
fi

# The canonical secrets file lives in the repo, never in a release snapshot.
export OPSROOM_ENV_FILE="$REPO/.env"
# The agent edits the repo, whatever it is running from.
export OPSROOM_SANDBOX_ROOT="${OPSROOM_SANDBOX_ROOT:-$REPO}"

exec "$NODE" "$RUN_DIR/src/ask.ts" "$@"
