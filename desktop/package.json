{
  "name": "gso1-desktop",
  "productName": "GSO-1",
  "version": "0.1.2",
  "description": "GSO-1 \u2014 a local application registry and launcher",
  "homepage": "https://github.com/rafsunsheikh/gso-1",
  "license": "Apache-2.0",
  "author": {
    "name": "Md Rafsun Sheikh",
    "email": "rafsunsheikh@users.noreply.github.com"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gso1.manager",
    "productName": "GSO-1",
    "copyright": "Copyright \u00a9 2026 Md Rafsun Sheikh",
    "directories": {
      "output": "../build/release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "afterPack.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../build/dist/gso1-server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": false
      }
    },
    "dmg": {
      "title": "GSO-1 ${version}"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "GSO-1"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "synopsis": "A local application registry and launcher",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "gso-1",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "afterPack": "./afterPack.js"
  }
}
