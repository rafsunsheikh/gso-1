# GSO-1 configuration, copy to `.env` and edit.
#
#   cp .env.example .env
#
# Real environment variables always win over this file. `.env` is gitignored
# and releases deliberately ship without one, so your secrets live in exactly
# one place.

# ─────────────────────────────────────────────────────────────────────────────
# Where your code lives  (the only setting most people need)
# ─────────────────────────────────────────────────────────────────────────────

# One or more project roots, comma-separated. Each entry may carry a display
# label as "Label:/path". Defaults to ~/Projects when unset.
MANAGER_PROJECTS_DIRS="My Projects:~/Projects"
# Example with two roots:
# MANAGER_PROJECTS_DIRS="Personal:~/Projects,Work:~/work/repos"

# Single-root alternative (ignored when MANAGER_PROJECTS_DIRS is set).
# MANAGER_PROJECTS_DIR=~/Projects

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────

# Bind address. 127.0.0.1 is loopback-only and unreachable from the network.
# ⚠️  Only change this if you also set MANAGER_MOBILE_TOKEN below. GSO-1 can
#     start processes and run commands as you, see SECURITY.md.
MANAGER_HOST=127.0.0.1
MANAGER_PORT=8420

# Set to 1 to stop GSO-1 opening a browser tab on start (used by launchd and
# the desktop shell, which manage their own window).
# MANAGER_NO_BROWSER=1

# ─────────────────────────────────────────────────────────────────────────────
# Phone companion  (optional, needed only for access from another device)
# ─────────────────────────────────────────────────────────────────────────────

# Shared secret for the /m companion. Requests that do not come from loopback
# must present it; with no token set they are refused outright. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# MANAGER_MOBILE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Telegram approvals  (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Bot token from @BotFather, and the chat id allowed to drive it.
# MANAGER_TELEGRAM_TOKEN=
# MANAGER_TELEGRAM_ALLOWED=
# MANAGER_APPROVAL_CHAT=

# Auto-approve agent tool requests instead of prompting. Leave off unless you
# fully trust what the agent is about to run.
# MANAGER_APPROVAL_AUTO=0

# ─────────────────────────────────────────────────────────────────────────────
# Local LLM  (optional, for running agent sessions on your own hardware)
# ─────────────────────────────────────────────────────────────────────────────

# Point Claude at GSO-1's built-in Anthropic→llama proxy instead of the API.
# MANAGER_LOCAL_ANTHROPIC_BASE_URL=http://127.0.0.1:8420/v1
# MANAGER_LOCAL_ANTHROPIC_API_KEY=

# llama-server binary and where it listens.
# LLAMA_SERVER_BIN=/opt/homebrew/bin/llama-server
# LLAMA_HOST=127.0.0.1
# LLAMA_PORT=8080

# Folders scanned for local .gguf models, comma-separated.
# MANAGER_MODEL_DIRS=~/models

# ─────────────────────────────────────────────────────────────────────────────
# Jekyll site CMS  (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Point this at a Jekyll checkout to edit its posts and pages from the
# dashboard. There is no default: with this unset the CMS stays switched off.
# MANAGER_SITE_DIR=~/Projects/your-site.github.io

# ─────────────────────────────────────────────────────────────────────────────
# Web search  (optional)
# ─────────────────────────────────────────────────────────────────────────────

# TAVILY_API_KEY=
