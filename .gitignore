# Local design handoff archives, not part of the distribution
*.zip

# Packaging output, installers and the frozen server are built, never committed
build/dist/
build/release/
build/work/

# Article drafts, kept with the project but not part of it
article/

# Local 3D assets for the French World. Deliberately never committed: the
# Pokemon and Ash models are Nintendo/Game Freak/Creatures characters and the
# village is somebody else's scan, and this repository is public under
# Apache-2.0. GSO-1 serves them off disk so the world works on the machine that
# downloaded them, and ships none of them.
3d_objects/

# Pro add-ons. They live in their own private repository and are loaded from
# here when present (thecmanager/addons.py); this public one never carries them.
pro/

# The website video: its source is kept, its installs and renders are rebuilt.
site-video/node_modules/
site-video/out/
